# Скопируйте в .env.local — секреты НЕ коммитить
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=77081954904

# MongoDB Atlas (Vercel Storage integration)
MONGODB_URI=mongodb+srv://...
MONGODB_DB=mediavitamins

# Vercel Blob (mediavitamins-blob, private store)
# Подключите store к проекту в Vercel → Storage → mediavitamins-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Kaspi Pay (см. docs/kaspi-oplata.md)
# KASPI_PROVIDER=none|link|apipay|kaspi
# KASPI_PAY_URL=https://...  # временная статическая ссылка от менеджера (сумма не подставляется)
# APIPAY_API_KEY=
# KASPI_API_KEY=
# KASPI_TRADE_POINT_ID=

# Опционально
# HF_TOKEN=hf_...  # scripts/generate-goal-images.mjs
