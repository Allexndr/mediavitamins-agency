<script>
        let currentStep = 1;

        function nextStep() {
            if (currentStep < 3) {
                // Hide current
                document.getElementById(`step-${currentStep}`).classList.add('hidden');
                
                // Increment
                currentStep++;
                
                // Show next
                const nextEl = document.getElementById(`step-${currentStep}`);
                nextEl.classList.remove('hidden');
                nextEl.classList.add('animate-fade-in');

                // Update Progress UI
                const progress = (currentStep / 3) * 100;
                document.getElementById('progress-bar').style.width = `${progress}%`;

                // Update Button Label
                const btnText = document.getElementById('button-text');
                if (currentStep === 2) {
                    btnText.innerText = "Proceed to Payment";
                } else if (currentStep === 3) {
                    btnText.innerText = "Order Now";
                    // Change theme of button to suggest finality
                    document.getElementById('next-button').classList.add('bg-deep-charcoal');
                    document.getElementById('next-button').classList.remove('bg-primary');
                }
                
                // Scroll to top of main
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                alert("Thank you for your order! Your wellness journey starts now.");
                // Usually redirect to success page
            }
        }
    </script>
